# ====================================================================
# TaskFlow Environment Variables (Template)
# Copy to .env for Docker Compose or local PostgreSQL deployment:
#   cp .env.example .env
# ====================================================================

# Database Credentials
POSTGRES_DB=taskflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Secret Key
# MUST be a Base64-encoded string of at least 256 bits (32 bytes).
# Generate a new random secret with:
#   openssl rand -base64 32
#
# NOTE: Rotating this secret invalidates all previously issued JWT tokens!
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000
